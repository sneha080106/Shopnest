# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27017/shopnest

# Auth
JWT_SECRET=sristishree
JWT_EXPIRES_IN=7d

# Email (Nodemailer) - e.g. use an SMTP provider or a Gmail app password
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=cuterani312@example.com
EMAIL_PASSWORD=Sneha123*
EMAIL_FROM="ShopNest <no-reply@shopnest.example.com>"

# Admin seed account (used only by seed script)
# ADMIN_PASSWORD is REQUIRED unless NODE_ENV is development/test with a local MONGO_URI.
# In any other environment the seed refuses to run without a strong password
# (12+ chars with upper, lower, digit and symbol). Replace the placeholder below.
ADMIN_EMAIL=admin@shopnest.example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Rate limiting (all optional — sensible defaults are used if left unset)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_PAYMENT_MAX=30
